// Cloudflare Pages Function — runs on every request to your site.
//
// Layer 1: Hard 403 for known AI crawler/bot user agents.
// Layer 2: Everything else must pass a click-through "human" check before
//          it sees real content. This stops plain fetchers/scrapers (the
//          kind AI tools use to "read" a page) that never load and execute
//          JavaScript or click a button — even if they don't send a
//          recognizable bot User-Agent.
//
// Known search engines (Google, Bing, etc.) are exempted from the
// click-through so normal SEO/indexing still works.

const AI_BOT_PATTERNS = [
  "gptbot",
  "chatgpt-user",
  "oai-searchbot",
  "claudebot",
  "claude-web",
  "claude-searchbot",
  "anthropic-ai",
  "ccbot",
  "google-extended",
  "bytespider",
  "perplexitybot",
  "applebot-extended",
  "amazonbot",
  "diffbot",
  "facebookbot",
  "meta-externalagent",
  "youbot",
  "omgilibot",
  "omgili",
  "cohere-ai",
  "timpibot",
  "imagesiftbot",
  "ai2bot",
];

// Legit search engines — let these through untouched so search
// indexing/SEO doesn't break.
const SEARCH_ENGINE_PATTERNS = [
  "googlebot",
  "bingbot",
  "duckduckbot",
  "slurp",
  "baiduspider",
  "yandexbot",
  "applebot/", // Apple's regular search bot, not the AI-training "Applebot-Extended"
];

const COOKIE_NAME = "human_verified";
const COOKIE_MAX_AGE = 60 * 60 * 12; // 12 hours

function isStaticAsset(pathname) {
  return /\.(css|js|mjs|png|jpe?g|gif|svg|webp|ico|woff2?|ttf|json|xml|map)$/i.test(pathname);
}

export async function onRequest(context) {
  const { request } = context;
  const url = new URL(request.url);
  const userAgent = (request.headers.get("user-agent") || "").toLowerCase();

  // Layer 1: hard block known AI bots outright, no matter what they request.
  if (AI_BOT_PATTERNS.some((p) => userAgent.includes(p))) {
    return new Response("Access denied: AI crawlers are not permitted on this site.", {
      status: 403,
      headers: { "content-type": "text/plain" },
    });
  }

  // Always let robots.txt and static assets (css/js/images) through directly.
  if (url.pathname === "/robots.txt" || isStaticAsset(url.pathname)) {
    return context.next();
  }

  // Known search engines skip the click-through so SEO keeps working.
  if (SEARCH_ENGINE_PATTERNS.some((p) => userAgent.includes(p))) {
    return context.next();
  }

  // Layer 2: everyone else needs the human-verified cookie.
  const cookieHeader = request.headers.get("cookie") || "";
  const hasCookie = cookieHeader
    .split(";")
    .some((c) => c.trim().startsWith(`${COOKIE_NAME}=`));

  if (hasCookie) {
    return context.next();
  }

  return new Response(interstitialHTML(url.pathname + url.search), {
    status: 200,
    headers: { "content-type": "text/html; charset=utf-8" },
  });
}

function interstitialHTML(redirectTo) {
  return `<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>GioTV — Verify you're human</title>
<style>
  html, body { height: 100%; margin: 0; }
  body {
    display: flex; align-items: center; justify-content: center;
    background: #0b0b0f; color: #f5f5f5;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
  }
  .card {
    text-align: center; max-width: 380px; padding: 32px 28px;
    background: #16161d; border-radius: 16px; box-shadow: 0 10px 40px rgba(0,0,0,0.4);
  }
  h1 { font-size: 20px; margin: 0 0 8px; }
  p { font-size: 14px; color: #b3b3bb; margin: 0 0 24px; line-height: 1.5; }
  button {
    background: #ef233c; color: #fff; border: none; border-radius: 999px;
    padding: 12px 28px; font-size: 15px; font-weight: 600; cursor: pointer;
  }
  button:hover { background: #d61f37; }
</style>
</head>
<body>
  <div class="card">
    <h1>Just checking you're human</h1>
    <p>This keeps automated bots and AI crawlers off GioTV. Tap below to continue.</p>
    <button id="continueBtn">Continue to GioTV</button>
  </div>
  <script>
    document.getElementById('continueBtn').addEventListener('click', function () {
      document.cookie = "${COOKIE_NAME}=1; path=/; max-age=${COOKIE_MAX_AGE}; SameSite=Lax; Secure";
      window.location.href = ${JSON.stringify(redirectTo)};
    });
  </script>
</body>
</html>`;
}
